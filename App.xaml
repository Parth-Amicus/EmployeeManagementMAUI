<?xml version = "1.0" encoding = "UTF-8" ?>

<!-- global level resources and styles -->
    
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:EmployeeManagementMAUI"
             xmlns:converters="clr-namespace:EmployeeManagementMAUI.Converters"
             x:Class="EmployeeManagementMAUI.App">
    <Application.Resources>
        <ResourceDictionary>

            <!--Converters-->
            <converters:StatusToBackgroundConverter
            x:Key="StatusToBackgroundConverter" />

            <converters:DateToRelativeTextConverter
            x:Key="DateToRelativeTextConverter" />

            <converters:InverseBooleanConverter
            x:Key="InverseBooleanConverter" />

            <!-- COLORS -->

            <!-- Primary colors -->
            <Color x:Key="Primary">#2563EB</Color>
            <Color x:Key="PrimaryDark">#1D4ED8</Color>
            <Color x:Key="PrimaryLight">#DBEAFE</Color>
            <Color x:Key="PrimarySoft">#EFF6FF</Color>

            <!-- Background and surface colors -->
            <Color x:Key="PageBackground">#F1F5F9</Color>
            <Color x:Key="Surface">#FFFFFF</Color>

            <!-- Text colors -->
            <Color x:Key="TextPrimary">#0F172A</Color>
            <Color x:Key="TextSecondary">#64748B</Color>
            <Color x:Key="TextMuted">#94A3B8</Color>
            <Color x:Key="TextWhite">#FFFFFF</Color>

            <!-- Border colors -->
            <Color x:Key="BorderColor">#E2E8F0</Color>
            <Color x:Key="PhotoBorder">#DBEAFE</Color>

            <!-- Status colors -->
            <Color x:Key="StatusPending">#D97706</Color>
            <Color x:Key="StatusInProgress">#7C3AED</Color>
            <Color x:Key="StatusCompleted">#16A34A</Color>

            <!-- Status badge background colours (lighter tints for pill bg) -->
            <Color x:Key="StatusPendingBackground">#FEF3C7</Color>
            <Color x:Key="StatusInProgressBackground">#EDE9FE</Color>
            <Color x:Key="StatusCompletedBackground">#DCFCE7</Color>

            <!-- Priority colors -->
            <Color x:Key="PriorityHighBackground">#FEE2E2</Color>
            <Color x:Key="PriorityHighText">#B91C1C</Color>

            <Color x:Key="PriorityMediumBackground">#FEF3C7</Color>
            <Color x:Key="PriorityMediumText">#B45309</Color>

            <Color x:Key="PriorityLowBackground">#DCFCE7</Color>
            <Color x:Key="PriorityLowText">#15803D</Color>

            <!-- FONT SIZES -->
            
            <x:Double x:Key="FontSizeCaption">12</x:Double>
            <x:Double x:Key="FontSizeSmall">13</x:Double>
            <x:Double x:Key="FontSizeBody">14</x:Double>
            <x:Double x:Key="FontSizeMedium">15</x:Double>
            <x:Double x:Key="FontSizeCardTitle">16</x:Double>
            <x:Double x:Key="FontSizeSectionTitle">20</x:Double>
            <x:Double x:Key="FontSizePageTitle">26</x:Double>
            <x:Double x:Key="FontSizeProfileName">22</x:Double>
            <x:Double x:Key="FontSizeProfileTitle">24</x:Double>
            <x:Double x:Key="FontSizeCount">28</x:Double>
            <x:Double x:Key="FontSizeHeadline">32</x:Double>
            <x:Double x:Key="FontSizeSubHeadline">24</x:Double>

            <!-- SPACING -->

            <x:Double x:Key="SpacingExtraSmall">2</x:Double>
            <x:Double x:Key="SpacingSmall">4</x:Double>
            <x:Double x:Key="SpacingMedium">8</x:Double>
            <!-- SpacingLarge: gap between list cards (ItemSpacing in LinearItemsLayout) -->
            <x:Double x:Key="SpacingLarge">8</x:Double>
            <x:Double x:Key="SpacingExtraLarge">12</x:Double>
            <x:Double x:Key="SpacingCard">14</x:Double>
            <!-- SpacingPage: outer page padding (left/right inset beside cards) -->
            <x:Double x:Key="SpacingPage">14</x:Double>
            <x:Double x:Key="SpacingProfile">20</x:Double>
            <!-- SpacingDashboardSection: vertical gap between dashboard sections -->
            <x:Double x:Key="SpacingDashboardSection">16</x:Double>
            <x:Double x:Key="SpacingMainContent">20</x:Double>


            <!-- OTHER REUSABLE DIMENSIONS -->

            <x:Double x:Key="CardCornerRadius">12</x:Double>
            <x:Double x:Key="SummaryCardCornerRadius">14</x:Double>
            <x:Int32 x:Key="ButtonCornerRadius">12</x:Int32>
            <x:Double x:Key="SmallCornerRadius">8</x:Double>
            <x:Double x:Key="CardBorderThickness">1</x:Double>
            <x:Double x:Key="NoBorderThickness">0</x:Double>
            <x:Double x:Key="DividerThickness">1</x:Double>
            <x:Double x:Key="IconSize">20</x:Double>
            <x:Double x:Key="ContactIconSize">42</x:Double>
            <x:Double x:Key="ProfilePhotoSize">116</x:Double>
            <x:Double x:Key="ButtonHeight">50</x:Double>
            <x:Double x:Key="MinTouchTarget">44</x:Double>
            <x:Double x:Key="ShadowRadius">10</x:Double>
            <x:Double x:Key="ShadowOpacity">0.4</x:Double>
            <x:Double x:Key="ProfileCardBorderThickness">1</x:Double>
            <x:Double x:Key="ProfilePhotoBorderThickness">3</x:Double>
            <x:Double x:Key="DashboardHeaderHeight">64</x:Double>
            <!-- PageHorizontalInset: fixed left/right gutter columns on the Dashboard -->
            <x:Double x:Key="PageHorizontalInset">14</x:Double>

           
            <!-- COMPOSITE PADDING / MARGIN -->

            <Thickness x:Key="SummaryCardPadding">14,10</Thickness>
            <!-- DashboardContentPadding: top/bottom breathing room inside the dashboard scroll area -->
            <Thickness x:Key="DashboardContentPadding">0,6,0,16</Thickness>
            <Thickness x:Key="PriorityTagPadding">8,4</Thickness>
            <Thickness x:Key="PriorityTagMargin">0,0,8,6</Thickness>
            <!-- InspectionCardPadding: inner padding of each inspection row card -->
            <Thickness x:Key="InspectionCardPadding">14,12</Thickness>
            <Thickness x:Key="ProfileCardPadding">20</Thickness>
            <Thickness x:Key="BadgePadding">12,4</Thickness>
            <Thickness x:Key="BadgeMargin">0,4,0,0</Thickness>
            <Thickness x:Key="DividerMargin">0,6</Thickness>
            <Thickness x:Key="ContactRowMargin">0,6,0,0</Thickness>
            <Thickness x:Key="PaddingMainPage">24,0</Thickness>
            <Thickness x:Key="CardBottomMargin">0,0,0,8</Thickness>
            <Thickness x:Key="ButtonInlinePadding">14,10</Thickness>

            <!-- ============================= -->
            <!-- FONT FAMILIES -->
            <!-- ============================= -->

            <x:String x:Key="RegularFont">OpenSansRegular</x:String>
            <x:String x:Key="SemiboldFont">OpenSansSemibold</x:String>
            <x:String x:Key="BoldFont">PoppinsBold</x:String>
            <!-- ============================= -->
            <!-- IMPLICIT STYLE -->
            <!-- ============================= -->

            <!-- Applied automatically to Labels
                 unless a different explicit style is assigned -->
            <Style TargetType="Label">
                <Setter Property="FontFamily"
                        Value="{StaticResource RegularFont}" />
                <Setter Property="FontSize"
                        Value="{StaticResource FontSizeBody}" />
                <Setter Property="TextColor"
                        Value="{StaticResource TextPrimary}" />
            </Style>

            <!-- ============================= -->
            <!-- EXPLICIT STYLES -->
            <!-- ============================= -->

            <!-- Page heading style -->
            <Style x:Key="PageTitleLabelStyle"
                   TargetType="Label">
                <Setter Property="FontFamily"
                        Value="{StaticResource SemiboldFont}" />
                <Setter Property="FontSize"
                        Value="{StaticResource FontSizePageTitle}" />
                <Setter Property="TextColor"
                        Value="{StaticResource TextPrimary}" />
            </Style>

            <!-- Section heading style -->
            <Style x:Key="SectionTitleLabelStyle"
                   TargetType="Label">
                <Setter Property="FontFamily"
                        Value="{StaticResource SemiboldFont}" />
                <Setter Property="FontSize"
                        Value="{StaticResource FontSizeSectionTitle}" />
                <Setter Property="TextColor"
                        Value="{StaticResource TextPrimary}" />
            </Style>

            <!-- Inspection title style -->
            <Style x:Key="InspectionTitleLabelStyle"
                   TargetType="Label">
                <Setter Property="FontFamily"
                        Value="{StaticResource SemiboldFont}" />
                <Setter Property="FontSize"
                        Value="{StaticResource FontSizeCardTitle}" />
                <Setter Property="TextColor"
                        Value="{StaticResource TextPrimary}" />
            </Style>

            <!-- Primary action button style -->
            <Style x:Key="PrimaryButtonStyle"
                   TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource Primary}" />
                <Setter Property="TextColor"
                        Value="{StaticResource TextWhite}" />
                <Setter Property="FontFamily"
                        Value="{StaticResource SemiboldFont}" />
                <Setter Property="FontSize"
                        Value="{StaticResource FontSizeMedium}" />
                <Setter Property="CornerRadius"
                        Value="{StaticResource CardCornerRadius}" />
                <Setter Property="HeightRequest"
                        Value="{StaticResource ButtonHeight}" />
            </Style>

            <!-- Card Border style -->
            <!-- Applies the repeating white-surface card appearance used throughout the app -->
            <Style x:Key="CardBorderStyle"
                   TargetType="Border">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource Surface}" />
                <Setter Property="Stroke"
                        Value="{StaticResource BorderColor}" />
                <Setter Property="StrokeThickness"
                        Value="{StaticResource CardBorderThickness}" />
                <Setter Property="StrokeShape"
                        Value="RoundRectangle 12" />
            </Style>

            <!--
                CardTemplate — ControlTemplate for the standard card shell.

                Usage (on a ContentView):
                    <ContentView ControlTemplate="{StaticResource CardTemplate}"
                                 Padding="16,12">
                        <YourContent />
                    </ContentView>

                The host ContentView's Padding is forwarded to the inner Border
                via TemplateBinding so each usage site controls its own spacing.
            -->
            <ControlTemplate x:Key="CardTemplate">
                <Border BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeThickness="{StaticResource CardBorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource TextPrimary}"
                                Offset="0,4"
                                Radius="12"
                                Opacity="0.06" />
                    </Border.Shadow>
                    <ContentPresenter />
                </Border>
            </ControlTemplate>

            <!-- Status badge label style -->
            <!-- Used for the inspection Status text shown in the top-right of every card. -->
            <Style x:Key="StatusLabelStyle"
                   TargetType="Label">
                <Setter Property="FontSize"
                        Value="{StaticResource FontSizeCaption}" />
                <Setter Property="FontAttributes"
                        Value="Bold" />
                <Setter Property="TextColor"
                        Value="{StaticResource Primary}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
