<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EmployeeManagementMAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:EmployeeManagementMAUI.Views"
    Shell.NavBarIsVisible="False"
    
    
    Title="EmployeeManagementMAUI">

    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Shell.FlyoutItemIsVisible="False" />

    <TabBar Route="main">
        <ShellContent
            Title="Dashboard"
            Route="dashboard"
            ContentTemplate="{DataTemplate views:DashboardPage}" />

        <ShellContent
            Title="Inspections"
            Route="inspections"
            ContentTemplate="{DataTemplate views:InspectionListPage}" />

        <ShellContent
            Title="Profile"
            Route="profile"
            ContentTemplate="{DataTemplate views:InspectorProfilePage}" />
    </TabBar>

</Shell>
