<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EmployeeManagementMAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:EmployeeManagementMAUI.Views"
    Shell.NavBarIsVisible="False"
    
    
    Title="EmployeeManagementMAUI">

    <!--
        Root page — Dashboard.
        NavBarIsVisible="False" hides the Shell chrome so DashboardPage
        controls its own header row (title + profile icon).
    -->
    <ShellContent
        Route="dashboard"
        ContentTemplate="{DataTemplate views:DashboardPage}" />

</Shell>
