<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EmployeeManagementMAUI.ViewModels"
    xmlns:models="clr-namespace:EmployeeManagementMAUI.Models"
    x:Class="EmployeeManagementMAUI.Views.InspectionListListViewPage"
    x:DataType="vm:InspectionListViewModel"
    Title="Inspections - ListView"
    BackgroundColor="{StaticResource PageBackground}"
    SafeAreaEdges="All">

    <Grid Padding="{StaticResource SpacingPage}"
          RowDefinitions="Auto,*"
          RowSpacing="{StaticResource SpacingCard}">

        <Label Grid.Row="0"
               Text="Inspections - ListView"
               Style="{StaticResource PageTitleLabelStyle}" />

        <ListView Grid.Row="1"
                  ItemsSource="{Binding Inspections}"
                  HasUnevenRows="True"
                  SeparatorVisibility="None"
                  SelectionMode="Single"
                  BackgroundColor="Transparent">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:InspectionItem">

                    <Grid Padding="{StaticResource SpacingSmall}"
                          Margin="0,0,0,0">

                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource BorderColor}"
                                StrokeThickness="{StaticResource CardBorderThickness}"
                                StrokeShape="RoundRectangle 12"
                                Padding="{StaticResource SpacingCard}"
                                Margin="0,0,0,12">

                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="{StaticResource SpacingMedium}">

                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding Title}"
                                       Style="{StaticResource InspectionTitleLabelStyle}" />

                                <Label Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding Status}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />

                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding Site, StringFormat='Site: {0}'}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       TextColor="{StaticResource TextSecondary}" />

                                <Label Grid.Row="2"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding ScheduledDate, StringFormat='{}{0:dd MMM yyyy, hh:mm tt}'}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       TextColor="{StaticResource TextSecondary}" />

                            </Grid>
                        </Border>
                    </Grid>

                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
    </Grid>
</ContentPage>
