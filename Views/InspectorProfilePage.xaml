<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmployeeManagementMAUI.ViewModels"
             x:Class="EmployeeManagementMAUI.Views.InspectorProfilePage"
             x:DataType="vm:InspectorProfileViewModel"
             Title="My Profile"
             BackgroundColor="#F1F5F9"
             SafeAreaEdges="All"
             >

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Profile Card -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="#E2E8F0"
                    StrokeThickness="4"
                    StrokeShape="RoundRectangle 10"
                    Padding="24">
                <Border.Shadow>
                    <Shadow Brush="#0F172A"
                            Offset="0,4"
                            Radius="12"
                            Opacity="0.06" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">

                    <!-- Inspector Photo -->
                    <Border WidthRequest="116"
                            HeightRequest="116"
                            Stroke="#DBEAFE"
                            StrokeThickness="2"
                            HorizontalOptions="Center"
                            StrokeShape="Ellipse">
                        <Image Source="{Binding Inspector.Photo}"
                               Aspect="AspectFill" />
                    </Border>

                    <!-- Name, Role & Badge -->
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="{Binding Inspector.Name}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               HorizontalTextAlignment="Center" />

                        <Label Text="{Binding Inspector.Role}"
                               FontSize="15"
                               TextColor="#64748B"
                               HorizontalTextAlignment="Center" />

                        <!-- Employee ID Pill Badge -->
                        <Border BackgroundColor="#EFF6FF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,5"
                                Margin="0,4,0,0"
                                HorizontalOptions="Center">
                            <Label Text="{Binding Inspector.EmployeeId, StringFormat='Employee ID: {0}'}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#1D4ED8" />
                        </Border>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="#E2E8F0"
                             Margin="0,8" />

                    <!-- Contact Information Heading -->
                    <Label Text="Contact Information"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <!-- Email Row -->
                    <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                        <Border WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="#EFF6FF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Path Data="M4,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,11L20,6H4L12,11M4,18H20V8.37L12,13.36L4,8.37V18Z"
                                  Fill="#2563EB"
                                  HeightRequest="20"
                                  WidthRequest="20"
                                  Aspect="Uniform"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Email"
                                   FontSize="12"
                                   TextColor="#64748B" />
                            <Label Text="{Binding Inspector.Email}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Phone Row -->
                    <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                        <Border WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="#EFF6FF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Path Data="M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5A1,1 0 0,1 21,16.5V20A1,1 0 0,1 20,21A17,17 0 0,1 3,4A1,1 0 0,1 4,3H7.5A1,1 0 0,1 8.5,4C8.5,5.25 8.7,6.45 9.07,7.57C9.18,7.92 9.1,8.31 8.82,8.59L6.62,10.79Z"
                                  Fill="#2563EB"
                                  HeightRequest="20"
                                  WidthRequest="20"
                                  Aspect="Uniform"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Phone"
                                   FontSize="12"
                                   TextColor="#64748B" />
                            <Label Text="{Binding Inspector.Phone}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Edit Button -->
                    <Button Text="Edit Profile"
                            Command="{Binding EditCommand}"
                            BackgroundColor="#2563EB"
                            TextColor="#FFFFFF"
                            CornerRadius="12"
                            HeightRequest="50"
                            FontSize="15"
                            FontAttributes="Bold"
                            Margin="0,12,0,0" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
