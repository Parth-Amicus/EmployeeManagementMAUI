<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmployeeManagementMAUI.ViewModels"
             x:Class="EmployeeManagementMAUI.Views.InspectorProfilePage"
             x:DataType="vm:InspectorProfileViewModel"
             Title="My Profile"
             Shell.NavBarIsVisible="True"
             Shell.BackButtonBehavior="{x:Null}"
             BackgroundColor="{StaticResource PageBackground}"
             SafeAreaEdges="All">

    <ScrollView>
        <VerticalStackLayout
            Padding="{StaticResource SpacingPage}"
            Spacing="{StaticResource SpacingPage}">

            <!-- Profile Card — shell provided by CardTemplate ControlTemplate -->
            <ContentView ControlTemplate="{StaticResource CardTemplate}"
                         Padding="{StaticResource ProfileCardPadding}">

                <VerticalStackLayout Spacing="{StaticResource SpacingCard}">

                    <!-- Inspector Photo -->
                    <Border WidthRequest="{StaticResource ProfilePhotoSize}"
                            HeightRequest="{StaticResource ProfilePhotoSize}"
                            Stroke="{StaticResource PhotoBorder}"
                            StrokeThickness="{StaticResource ProfilePhotoBorderThickness}"
                            HorizontalOptions="Center"
                            StrokeShape="Ellipse">

                        <Image Source="{Binding Inspector.Photo}"
                               Aspect="AspectFill" />
                    </Border>

                    <!-- Name, Role & Badge -->
                    <VerticalStackLayout Spacing="{StaticResource SpacingSmall}"
                                         HorizontalOptions="Center">

                        <Label Text="{Binding Inspector.Name}"
                               Style="{StaticResource PageTitleLabelStyle}"
                               FontSize="{StaticResource FontSizeProfileName}"
                               HorizontalTextAlignment="Center" />

                        <Label Text="{Binding Inspector.Role}"
                               FontSize="{StaticResource FontSizeMedium}"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center" />

                        <!-- Employee ID Pill Badge -->
                        <Border BackgroundColor="{StaticResource PrimarySoft}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="{StaticResource BadgePadding}"
                                Margin="{StaticResource BadgeMargin}"
                                HorizontalOptions="Center">

                            <Label Text="{Binding Inspector.EmployeeId, StringFormat='Employee ID: {0}'}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   FontFamily="{StaticResource SemiboldFont}"
                                   TextColor="{StaticResource PrimaryDark}" />
                        </Border>

                    </VerticalStackLayout>

                    <BoxView HeightRequest="{StaticResource DividerThickness}"
                             Color="{StaticResource BorderColor}"
                             Margin="{StaticResource DividerMargin}" />

                    <!-- Contact Information Heading -->
                    <Label Text="Contact Information"
                           Style="{StaticResource InspectionTitleLabelStyle}" />

                    <!-- Email Row -->
                    <HorizontalStackLayout Spacing="{StaticResource SpacingExtraLarge}"
                                           VerticalOptions="Center">

                        <Border WidthRequest="{StaticResource ContactIconSize}"
                                HeightRequest="{StaticResource ContactIconSize}"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">

                            <Path Data="M4,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,11L20,6H4L12,11M4,18H20V8.37L12,13.36L4,8.37V18Z"
                                  Fill="{StaticResource Primary}"
                                  HeightRequest="{StaticResource IconSize}"
                                  WidthRequest="{StaticResource IconSize}"
                                  Aspect="Uniform"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Spacing="{StaticResource SpacingExtraSmall}"
                                             VerticalOptions="Center">

                            <Label Text="Email"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Label Text="{Binding Inspector.Email}"
                                   FontSize="{StaticResource FontSizeMedium}"
                                   FontFamily="{StaticResource SemiboldFont}"
                                   TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>

                    </HorizontalStackLayout>

                    <!-- Phone Row -->
                    <HorizontalStackLayout Spacing="{StaticResource SpacingExtraLarge}"
                                           VerticalOptions="Center">

                        <Border WidthRequest="{StaticResource ContactIconSize}"
                                HeightRequest="{StaticResource ContactIconSize}"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">

                            <Path Data="M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5A1,1 0 0,1 21,16.5V20A1,1 0 0,1 20,21A17,17 0 0,1 3,4A1,1 0 0,1 4,3H7.5A1,1 0 0,1 8.5,4C8.5,5.25 8.7,6.45 9.07,7.57C9.18,7.92 9.1,8.31 8.82,8.59L6.62,10.79Z"
                                  Fill="{StaticResource Primary}"
                                  HeightRequest="{StaticResource IconSize}"
                                  WidthRequest="{StaticResource IconSize}"
                                  Aspect="Uniform"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Spacing="{StaticResource SpacingExtraSmall}"
                                             VerticalOptions="Center">

                            <Label Text="Phone"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Label Text="{Binding Inspector.Phone}"
                                   FontSize="{StaticResource FontSizeMedium}"
                                   FontFamily="{StaticResource SemiboldFont}"
                                   TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>

                    </HorizontalStackLayout>

                    <!-- Edit Button -->
                    <Button Text="Edit Profile"
                            Command="{Binding EditCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="{StaticResource ContactRowMargin}" />

                </VerticalStackLayout>
            </ContentView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
