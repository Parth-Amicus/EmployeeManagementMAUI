<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EmployeeManagementMAUI.ViewModels"
    xmlns:models="clr-namespace:EmployeeManagementMAUI.Models"
    xmlns:controls="clr-namespace:EmployeeManagementMAUI.Controls"
    x:Class="EmployeeManagementMAUI.Views.InspectionListPage"
    x:DataType="vm:InspectionListViewModel"
    Title="Inspections"
    Shell.NavBarIsVisible="True"
    Shell.BackButtonBehavior="{x:Null}"
    Shell.BackgroundColor="#1D4ED8"
    BackgroundColor="{StaticResource PageBackground}"
    SafeAreaEdges="All">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="{StaticResource SpacingPage}"
          RowSpacing="{StaticResource SpacingCard}">
        

        <!-- Page Heading -->

        <VerticalStackLayout Grid.Row="0"
                             Spacing="{StaticResource SpacingLarge}">

            <VerticalStackLayout Spacing="{StaticResource SpacingSmall}">
                <Label Text="Inspections"
                       Style="{StaticResource PageTitleLabelStyle}" />

                <Label Text="View all scheduled inspections"
                       FontSize="{StaticResource FontSizeBody}"
                       TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>


            <!-- Entry control for searching inspections -->
            <Entry x:Name="SearchEntry"
                   Placeholder="Search by title, inspector or site"
                   BackgroundColor="{StaticResource Surface}"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   TextColor="{StaticResource TextPrimary}"
                   PlaceholderColor="{StaticResource TextMuted}"
                   ClearButtonVisibility="WhileEditing"
                   />

            <!-- Picker control for filtering by status -->
            <Picker x:Name="StatusPicker"
                    Title="Filter by status"
                    BackgroundColor="{StaticResource Surface}"
                    TextColor="{StaticResource TextPrimary}"
                    >

                <Picker.Items>
                    <x:String>All</x:String>
                    <x:String>Pending</x:String>
                    <x:String>In Progress</x:String>
                    <x:String>Completed</x:String>
                </Picker.Items>

            </Picker>

        </VerticalStackLayout>


        <!-- Shows loading progress while inspections are being loaded -->
        <ActivityIndicator Grid.Row="1"
                   IsRunning="{Binding IsBusy}"
                   IsVisible="{Binding IsBusy}"
                   Color="{StaticResource Primary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        <!-- Empty state message when no search results are found -->
        <Label Grid.Row="2"
       Text="No inspections found"
       TextColor="{StaticResource TextSecondary}"
       HorizontalOptions="Center"
       VerticalOptions="Center"
       IsVisible="{Binding ShowEmptyState,
                   Converter={StaticResource InverseBooleanConverter}}" />


        <!-- CollectionView -->
        <!-- item source connects the CollectionView to the Inspections collection in our ViewModel-->
        <!-- selectionMode = "single" defines only one item can be selected-->
        <CollectionView Grid.Row="2"
                        x:Name="InspectionCollection"
                        ItemsSource="{Binding FilteredInspections}"
                        SelectionMode="Single"
                        VerticalScrollBarVisibility="Never">

            <!-- <CollectionView.EmptyView>
                <Label Text="No inspections available"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView> -->

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="{StaticResource SpacingLarge}" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Inspection">

                    <!--
                        CardTemplate provides the standard white-surface card shell
                        (rounded corners + drop shadow), matching the dashboard and
                        profile cards.  VisualStateManager on the ContentView host
                        lets the CollectionView drive the Normal / Selected highlight.
                    -->
                    <ContentView ControlTemplate="{StaticResource CardTemplate}"
                                 Padding="{StaticResource SpacingCard}">

                        <!-- Selected Item Visual States -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor"
                                                Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor"
                                                Value="{StaticResource PrimaryLight}" />
                                    </VisualState.Setters>
                                </VisualState>

                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                              RowDefinitions="Auto,Auto,Auto, Auto"
                              RowSpacing="{StaticResource SpacingMedium}">

                            <!-- Inspection Title -->
                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding Title}"
                                   Style="{StaticResource InspectionTitleLabelStyle}" />

                            <!-- Inspection Status — reusable StatusBadge control -->
                            <controls:StatusBadge
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Status="{Binding Status}"
                                   VerticalOptions="Center" />

                            <!--prority-->
                            <controls:StatusBadge
                                   Grid.Row="0"
                                   Grid.Column="3"
                                   Status="{Binding Priority}"
                                   VerticalOptions="Center" />


                            <!-- Site -->
                            <Label Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding SiteName,
                                          StringFormat='Site: {0}'}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextColor="{StaticResource TextSecondary}" />


                            <!-- Scheduled Date -->
                            <Label Grid.Row="2"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding ScheduledOn,StringFormat='Scheduled: {0}', Converter= {StaticResource DateToRelativeTextConverter}}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextColor="{StaticResource TextSecondary}" />

                            <!--Inspector name-->
                            <Label Grid.Row="1"
                                   Grid.Column="2"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding InspectorName,StringFormat='Inspector: {0}'}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextColor="{StaticResource TextSecondary}" />

                            <!--Auto-->
                            <Label Grid.Row="3"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding Notes, StringFormat= 'Notes : {0}'}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextColor="{StaticResource TextSecondary}" />



                        </Grid>


                    </ContentView>




                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
    
</ContentPage>
