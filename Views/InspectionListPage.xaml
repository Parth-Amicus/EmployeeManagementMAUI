<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EmployeeManagementMAUI.ViewModels"
    xmlns:models="clr-namespace:EmployeeManagementMAUI.Models"
    xmlns:controls="clr-namespace:EmployeeManagementMAUI.Controls"
    x:Class="EmployeeManagementMAUI.Views.InspectionListPage"
    x:DataType="vm:InspectionListViewModel"
    Title="Inspections"
    Shell.NavBarIsVisible="True"
    Shell.BackButtonBehavior="{x:Null}"
    Shell.BackgroundColor="#1D4ED8"
    BackgroundColor="{StaticResource PageBackground}"
    SafeAreaEdges="All">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="{StaticResource SpacingPage}"
          RowSpacing="{StaticResource SpacingCard}">
        

        <!-- Page Heading -->

        <VerticalStackLayout Grid.Row="0"
                             Spacing="{StaticResource SpacingLarge}">

            <VerticalStackLayout Spacing="{StaticResource SpacingSmall}">
                <Label Text="Inspections"
                       Style="{StaticResource PageTitleLabelStyle}" />

                <Label Text="View all scheduled inspections"
                       FontSize="{StaticResource FontSizeBody}"
                       TextColor="{StaticResource TextSecondary}" />
                
                
            </VerticalStackLayout>



            <!-- Search bar -->
            <Border
            BackgroundColor="{StaticResource Surface}"
            Stroke="#E2E5F2"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 30"
            Padding="14,4"
            Margin="0,0,0,16">

            <Grid ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="2"
            VerticalOptions="Center">

             <!-- Search icon -->
            <Label
            Grid.Column="0"
            Text="⌕"
            FontSize="30"
            TextColor="{StaticResource TextSecondary}"
            VerticalOptions="Center" />

            <!-- Search entry -->
            <Entry
            Grid.Column="1"
            x:Name="SearchEntry"
            Placeholder="Search by title, inspector or site"
            BackgroundColor="Transparent"
            Text="{Binding SearchText, Mode=TwoWay}"
            TextColor="{StaticResource TextPrimary}"
            PlaceholderColor="{StaticResource TextMuted}"
                
            ClearButtonVisibility="WhileEditing"
            VerticalOptions="Center" />

         
                </Grid>
            </Border>



        </VerticalStackLayout>

        

        <!-- Shows loading progress while inspections are being loaded -->
        <ActivityIndicator Grid.Row="1"                        
                   IsRunning="{Binding IsLoading}"
                   IsVisible="{Binding IsLoading}"
                   Color="{StaticResource Primary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        <RefreshView Grid.Row="2"
                     Command="{Binding RefreshInspectionsCommand}"
                     IsRefreshing="{Binding IsRefreshing}">

            <Grid>

                <!-- Empty state message when no search results are found -->
                <Label Text="No inspections found"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       IsVisible="{Binding ShowEmptyState,
                                   Converter={StaticResource InverseBooleanConverter}}" />


                <!-- CollectionView -->
                <!-- item source connects the CollectionView to the Inspections collection in our ViewModel-->
                <!-- selectionMode = "single" defines only one item can be selected-->


                <!--We used the SelectionChanged event because we needed direct access to SelectionChangedEventArgs to retrieve the selected inspection and navigate to its detail page. 
                Although MAUI supports SelectionChangedCommand too, we used the event to demonstrate event-based handling of this UI interaction-->
                
                <CollectionView x:Name="InspectionCollection"
                                ItemsSource="{Binding FilteredInspections}"
                                SelectionMode="Single"
                                SelectionChanged="OnInspectionSelectionChanged"
                                VerticalScrollBarVisibility="Never">

            <!-- <CollectionView.EmptyView>
                <Label Text="No inspections available"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView> -->

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="{StaticResource SpacingLarge}" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Inspection">

                    <ContentView ControlTemplate="{StaticResource CardTemplate}"
                                 Padding="{StaticResource SpacingCard}">

                        <!-- Selected Item Visual States to highlight -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor"
                                                Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor"
                                                Value="{StaticResource PrimaryLight}" />
                                    </VisualState.Setters>
                                </VisualState>

                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                              RowDefinitions="Auto,Auto,Auto, Auto"
                              RowSpacing="{StaticResource SpacingMedium}">

                            <!-- Inspection Title -->
                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding Title}"
                                   Style="{StaticResource InspectionTitleLabelStyle}" />

                            <!-- Inspection Status — reusable StatusBadge control -->
                            <controls:StatusBadge
                                   Grid.Row="0"
                                   Grid.Column="3"
                                   Status="{Binding Status}"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center" />

                            <!--prority-->
                            <controls:StatusBadge
                                   Grid.Row="2"
                                   Grid.Column="3"      
                                    HorizontalOptions="End"
                                   Status="{Binding Priority}"
                                   VerticalOptions="Center" />


                            <!-- Site -->
                            <Label Grid.Row="2"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding SiteName,
                                          StringFormat='Site: {0}'}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextColor="{StaticResource TextSecondary}" />


                            <!-- Scheduled Date -->
                            <Label Grid.Row="3"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding ScheduledOn,StringFormat='Scheduled: {0}', Converter= {StaticResource DateToRelativeTextConverter}}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextColor="{StaticResource TextSecondary}" />

                            <!--Inspector name-->
                                    <Label Grid.Row="3"
                                   Grid.Column="2"
                                   Grid.ColumnSpan="2"                                         
                                   Text="{Binding InspectorName,StringFormat='Inspector: {0}'}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextColor="{StaticResource TextSecondary}" />



                                </Grid>


                    </ContentView>




                </DataTemplate>
            </CollectionView.ItemTemplate>

                </CollectionView>

            </Grid>

        </RefreshView>
    </Grid>
    
</ContentPage>
