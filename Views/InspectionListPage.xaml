<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EmployeeManagementMAUI.ViewModels"
    xmlns:models="clr-namespace:EmployeeManagementMAUI.Models"
    x:Class="EmployeeManagementMAUI.Views.InspectionListPage"
    x:DataType="vm:InspectionListViewModel"
    Title="Inspections"
    BackgroundColor="{StaticResource PageBackground}"
    SafeAreaEdges="All">

    <Grid RowDefinitions="Auto,*"
          Padding="{StaticResource SpacingPage}"
          RowSpacing="{StaticResource SpacingCard}">

        <!-- Page Heading -->

        <VerticalStackLayout Grid.Row="0"
                             Spacing="{StaticResource SpacingLarge}">

            <VerticalStackLayout Spacing="{StaticResource SpacingSmall}">
                <Label Text="Inspections"
                       Style="{StaticResource PageTitleLabelStyle}" />

                <Label Text="View all scheduled inspections"
                       FontSize="{StaticResource FontSizeBody}"
                       TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <!-- Entry control for searching inspections -->
            <Entry x:Name="SearchEntry"
                   Placeholder="Search by title or site"
                   BackgroundColor="{StaticResource Surface}"
                   TextColor="{StaticResource TextPrimary}"
                   PlaceholderColor="{StaticResource TextMuted}"
                   ClearButtonVisibility="WhileEditing"
                   TextChanged="OnSearchTextChanged" />

            <!-- Picker control for filtering by status -->
            <Picker x:Name="StatusPicker"
                    Title="Filter by status"
                    BackgroundColor="{StaticResource Surface}"
                    TextColor="{StaticResource TextPrimary}"
                    SelectedIndexChanged="OnStatusChanged">

                <Picker.Items>
                    <x:String>All</x:String>
                    <x:String>Pending</x:String>
                    <x:String>In Progress</x:String>
                    <x:String>Completed</x:String>
                </Picker.Items>

            </Picker>

        </VerticalStackLayout>

        <!-- CollectionView -->
        <!-- item source connects the CollectionView to the Inspections collection in our ViewModel-->
        <!-- selectionMode = "single" defines only one item can be selected-->
        <CollectionView Grid.Row="1"
                        x:Name="InspectionCollection"
                        ItemsSource="{Binding Inspections}"
                        SelectionMode="Single"
                        VerticalScrollBarVisibility="Never">

            <CollectionView.EmptyView>
                <Label Text="No inspections available"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="{StaticResource SpacingLarge}" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:InspectionItem">

                    <Border
                        Stroke="{StaticResource BorderColor}"
                        StrokeThickness="{StaticResource CardBorderThickness}"
                        StrokeShape="RoundRectangle 12"
                        Padding="{StaticResource SpacingCard}">

                        <!-- Selected Item Visual States -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor"
                                                Value="{StaticResource Surface}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor"
                                                Value="{StaticResource PrimaryLight}" />
                                        <Setter Property="Stroke"
                                                Value="{StaticResource Primary}" />
                                    </VisualState.Setters>
                                </VisualState>

                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="{StaticResource SpacingMedium}">

                            <!-- Inspection Title -->
                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding Title}"
                                   Style="{StaticResource InspectionTitleLabelStyle}" />

                            <!-- Inspection Status -->
                            <Label Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding Status}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />

                            <!-- Site -->
                            <Label Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding Site,
                                          StringFormat='Site: {0}'}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextColor="{StaticResource TextSecondary}" />

                            <!-- Scheduled Date -->
                            <Label Grid.Row="2"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding ScheduledDate,
                                          StringFormat='{}{0:dd MMM yyyy, hh:mm tt}'}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextColor="{StaticResource TextSecondary}" />

                        </Grid>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>
