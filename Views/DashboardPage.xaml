<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EmployeeManagementMAUI.ViewModels"
    xmlns:models="clr-namespace:EmployeeManagementMAUI.Models"
    x:Class="EmployeeManagementMAUI.Views.DashboardPage"
    x:DataType="vm:DashboardViewModel"
    Title="Dashboard"
    BackgroundColor="{StaticResource PageBackground}"
    SafeAreaEdges="All">

    <!--
        GRID SIZING EXPLANATION:

        Rows:
        64  = Absolute size. Reserves a fixed 64-unit area for the heading.
        *   = Star size. Takes all remaining available vertical space.

        Columns:
        20  = Absolute size. Provides a fixed 20-unit left margin.
        *   = Star size. Takes the remaining width for page content.
        20  = Absolute size. Provides a fixed 20-unit right margin.

        Auto is used in the summary cards below:
        Auto adjusts each row or column to fit its content.
        This prevents the card content from receiving unnecessary fixed space.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource DashboardHeaderHeight}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource PageHorizontalInset}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{StaticResource PageHorizontalInset}" />
        </Grid.ColumnDefinitions>

        <!-- Dashboard Heading -->
        <Label Grid.Row="0"
               Grid.Column="1"
               Text="Dashboard"
               Style="{StaticResource PageTitleLabelStyle}"
               VerticalOptions="Center" />

        <!-- Scrollable Dashboard Content -->
        <ScrollView Grid.Row="1"
                    Grid.Column="1">

            <VerticalStackLayout
                Spacing="{StaticResource SpacingDashboardSection}"
                Padding="{StaticResource DashboardContentPadding}">

                <!-- Summary Cards -->
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,*"
                      RowSpacing="{StaticResource SpacingExtraLarge}"
                      ColumnSpacing="{StaticResource SpacingExtraLarge}">

                    <!-- Total Inspections -->
                    <Border Grid.Row="0"
                            Grid.Column="0"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="{StaticResource CardBorderThickness}"
                            StrokeShape="RoundRectangle {StaticResource SummaryCardCornerRadius}"
                            Padding="{StaticResource SummaryCardPadding}">

                        <VerticalStackLayout Spacing="{StaticResource SpacingMedium}">
                            <Label Text="Total"
                                   FontSize="{StaticResource FontSizeBody}"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Label Text="{Binding TotalInspections}"
                                   FontSize="{StaticResource FontSizeCount}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Pending Inspections -->
                    <Border Grid.Row="0"
                            Grid.Column="1"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="{StaticResource CardBorderThickness}"
                            StrokeShape="RoundRectangle {StaticResource SummaryCardCornerRadius}"
                            Padding="{StaticResource SummaryCardPadding}">

                        <VerticalStackLayout Spacing="{StaticResource SpacingMedium}">
                            <Label Text="Pending"
                                   FontSize="{StaticResource FontSizeBody}"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Label Text="{Binding PendingInspections}"
                                   FontSize="{StaticResource FontSizeCount}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource StatusPending}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- In Progress Inspections -->
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="{StaticResource CardBorderThickness}"
                            StrokeShape="RoundRectangle {StaticResource SummaryCardCornerRadius}"
                            Padding="{StaticResource SummaryCardPadding}">

                        <VerticalStackLayout Spacing="{StaticResource SpacingMedium}">
                            <Label Text="In Progress"
                                   FontSize="{StaticResource FontSizeBody}"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Label Text="{Binding InProgressInspections}"
                                   FontSize="{StaticResource FontSizeCount}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource StatusInProgress}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Completed Inspections -->
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="{StaticResource CardBorderThickness}"
                            StrokeShape="RoundRectangle {StaticResource SummaryCardCornerRadius}"
                            Padding="{StaticResource SummaryCardPadding}">

                        <VerticalStackLayout Spacing="{StaticResource SpacingMedium}">
                            <Label Text="Completed"
                                   FontSize="{StaticResource FontSizeBody}"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Label Text="{Binding CompletedInspections}"
                                   FontSize="{StaticResource FontSizeCount}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource StatusCompleted}" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- Today's Inspections -->
                <VerticalStackLayout Spacing="{StaticResource SpacingExtraLarge}">

                    <Label Text="Today's inspections"
                           Style="{StaticResource SectionTitleLabelStyle}" />

                    <!-- Priority Tags -->
                    <FlexLayout Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Start"
                                JustifyContent="Start">

                        <Border BackgroundColor="{StaticResource PriorityHighBackground}"
                                StrokeThickness="{StaticResource NoBorderThickness}"
                                StrokeShape="RoundRectangle {StaticResource SmallCornerRadius}"
                                Padding="{StaticResource PriorityTagPadding}"
                                Margin="{StaticResource PriorityTagMargin}">
                            <Label Text="High"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PriorityHighText}" />
                        </Border>

                        <Border BackgroundColor="{StaticResource PriorityMediumBackground}"
                                StrokeThickness="{StaticResource NoBorderThickness}"
                                StrokeShape="RoundRectangle {StaticResource SmallCornerRadius}"
                                Padding="{StaticResource PriorityTagPadding}"
                                Margin="{StaticResource PriorityTagMargin}">
                            <Label Text="Medium"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PriorityMediumText}" />
                        </Border>

                        <Border BackgroundColor="{StaticResource PriorityLowBackground}"
                                StrokeThickness="{StaticResource NoBorderThickness}"
                                StrokeShape="RoundRectangle {StaticResource SmallCornerRadius}"
                                Padding="{StaticResource PriorityTagPadding}"
                                Margin="{StaticResource PriorityTagMargin}">
                            <Label Text="Low"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PriorityLowText}" />
                        </Border>

                    </FlexLayout>

                    <!-- Inspection List -->
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding TodaysInspections}"
                        Spacing="{StaticResource SpacingLarge}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:InspectionItem">

                                <Border BackgroundColor="{StaticResource Surface}"
                                        Stroke="{StaticResource BorderColor}"
                                        StrokeThickness="{StaticResource CardBorderThickness}"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="{StaticResource InspectionCardPadding}">

                                    <Grid ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto,Auto"
                                          RowSpacing="{StaticResource SpacingMedium}">

                                        <!-- Inspection title -->
                                        <Label Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{Binding Title}"
                                               Style="{StaticResource InspectionTitleLabelStyle}"
                                               VerticalOptions="Center" />

                                        <!-- Inspection status -->
                                        <Label Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{Binding Status}"
                                               Style="{StaticResource StatusLabelStyle}"
                                               VerticalOptions="Center" />

                                        <!-- Inspection site -->
                                        <Label Grid.Row="1"
                                               Grid.Column="0"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Site, StringFormat='Site: {0}'}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               TextColor="{StaticResource TextSecondary}" />

                                        <!-- Scheduled date and time -->
                                        <Label Grid.Row="2"
                                               Grid.Column="0"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding ScheduledDate, StringFormat='{}{0:dd MMM yyyy, hh:mm tt}'}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               TextColor="{StaticResource TextSecondary}" />

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
