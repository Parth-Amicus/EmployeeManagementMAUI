<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EmployeeManagementMAUI.ViewModels"
    xmlns:models="clr-namespace:EmployeeManagementMAUI.Models"
    xmlns:controls="clr-namespace:EmployeeManagementMAUI.Controls"
    x:Class="EmployeeManagementMAUI.Views.DashboardPage"
    x:DataType="vm:DashboardViewModel"
    Title="Dashboard"
    BackgroundColor="{StaticResource PageBackground}"
    SafeAreaEdges="All">

    <!--
        GRID SIZING EXPLANATION:

        Rows:
        64  = Absolute size. Reserves a fixed 64-unit area for the heading.
        *   = Star size. Takes all remaining available vertical space.

        Columns:
        20  = Absolute size. Provides a fixed 20-unit left margin.
        *   = Star size. Takes the remaining width for page content.
        20  = Absolute size. Provides a fixed 20-unit right margin.

        Auto is used in the summary cards below:
        Auto adjusts each row or column to fit its content.
        This prevents the card content from receiving unnecessary fixed space.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource DashboardHeaderHeight}" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource PageHorizontalInset}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{StaticResource PageHorizontalInset}" />
        </Grid.ColumnDefinitions>

        <!-- Dashboard Header: title left, profile icon right -->
        <Grid Grid.Row="0"
              Grid.Column="1"
              ColumnDefinitions="*,Auto"
              VerticalOptions="Center">

            <Label Grid.Column="0"
                   Text="Dashboard"
                   Style="{StaticResource PageTitleLabelStyle}"
                   VerticalOptions="Center" />

            <!--
                Profile icon button — tinted circle with a person-silhouette Path.
                Tapped event is handled in DashboardPage.xaml.cs and pushes
                InspectorProfilePage onto the Shell navigation stack.
            -->
            <Border Grid.Column="1"
                    x:Name="ProfileIconBorder"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="{StaticResource PrimaryLight}"
                    StrokeThickness="0"
                    StrokeShape="Ellipse"
                    VerticalOptions="Center"
                    HorizontalOptions="End">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileIconTapped" />
                </Border.GestureRecognizers>

                <Image Source="user.svg"
                    WidthRequest="22"
                    HeightRequest="22"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />


            </Border>

        </Grid>

        <!-- Scrollable Dashboard Content -->
        <ScrollView Grid.Row="1"
                    Grid.Column="1">

            <VerticalStackLayout
                Spacing="{StaticResource SpacingDashboardSection}"
                Padding="{StaticResource DashboardContentPadding}">

                <!-- Summary Cards -->
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,*"
                      RowSpacing="{StaticResource SpacingExtraLarge}"
                      ColumnSpacing="{StaticResource SpacingExtraLarge}">

                    <!-- Total Inspections -->
                    <ContentView Grid.Row="0" 
                                 Grid.Column="0"
                                 ControlTemplate="{StaticResource CardTemplate}"
                                 Padding="{StaticResource SummaryCardPadding}">
                        <VerticalStackLayout Spacing="{StaticResource SpacingMedium}">
                            <Label Text="Total"
                                   FontSize="{StaticResource FontSizeBody}"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Label Text="{Binding TotalInspections}"
                                   FontSize="{StaticResource FontSizeCount}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </ContentView>

                    <!-- Pending Inspections -->
                    <ContentView Grid.Row="0"
                                 Grid.Column="1"
                                 ControlTemplate="{StaticResource CardTemplate}"
                                 Padding="{StaticResource SummaryCardPadding}">
                        <VerticalStackLayout Spacing="{StaticResource SpacingMedium}">
                            <Label Text="Pending"                                   
                                   FontSize="{StaticResource FontSizeBody}"
                                FontFamily="{StaticResource BoldFont}"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Label Text="{Binding PendingInspections}"
                                   FontSize="{StaticResource FontSizeCount}"
                                   FontAttributes="Bold"                                  
                                   TextColor="{StaticResource StatusPending}" />
                        </VerticalStackLayout>
                    </ContentView>

                    <!-- In Progress Inspections -->
                    <ContentView Grid.Row="1"
                                 Grid.Column="0"
                                 ControlTemplate="{StaticResource CardTemplate}"
                                 Padding="{StaticResource SummaryCardPadding}">
                        <VerticalStackLayout Spacing="{StaticResource SpacingMedium}">
                            <Label Text="In Progress"
                                   FontSize="{StaticResource FontSizeBody}"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Label Text="{Binding InProgressInspections}"
                                   FontSize="{StaticResource FontSizeCount}"
                                   FontAttributes="Bold"                                  
                                   TextColor="{StaticResource StatusInProgress}" />
                        </VerticalStackLayout>
                    </ContentView>

                    <!-- Completed Inspections -->
                    <ContentView Grid.Row="1"
                                 Grid.Column="1"
                                 ControlTemplate="{StaticResource CardTemplate}"
                                 Padding="{StaticResource SummaryCardPadding}">
                        <VerticalStackLayout Spacing="{StaticResource SpacingMedium}">
                            <Label Text="Completed"
                                   FontSize="{StaticResource FontSizeBody}"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Label Text="{Binding CompletedInspections}"
                                   FontSize="{StaticResource FontSizeCount}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource StatusCompleted}" />
                        </VerticalStackLayout>
                    </ContentView>

                </Grid>

                <!-- Today's Inspections -->
                <VerticalStackLayout Spacing="{StaticResource SpacingExtraLarge}">

                    <!--
                        Section header row: title on the left, "View All" link on the right.
                        The View All button is handled in code-behind and pushes
                        InspectionListPage via Shell.Current.GoToAsync("inspections").
                    -->
                    <Grid ColumnDefinitions="*,Auto"
                          VerticalOptions="Center">

                        <Label Grid.Column="0"
                               Text="Today's inspections"
                               Style="{StaticResource SectionTitleLabelStyle}"
                               VerticalOptions="Center" />

                        <Button Grid.Column="1"
                                x:Name="ViewAllButton"
                                Text="View All"
                                Clicked="OnViewAllTapped"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                FontFamily="{StaticResource SemiboldFont}"
                                FontSize="{StaticResource FontSizeBody}"
                                Padding="4,0"
                                VerticalOptions="Center"
                                HorizontalOptions="End" />

                    </Grid>

                    <!-- Priority Tags -->
                    <FlexLayout Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Start"
                                JustifyContent="Start">

                        <Border BackgroundColor="{StaticResource PriorityHighBackground}"
                                StrokeThickness="{StaticResource NoBorderThickness}"
                                Padding="{StaticResource PriorityTagPadding}"
                                Margin="{StaticResource PriorityTagMargin}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource SmallCornerRadius}" />
                            </Border.StrokeShape>
                            <Label Text="High"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PriorityHighText}" />
                        </Border>

                        <Border BackgroundColor="{StaticResource PriorityMediumBackground}"
                                StrokeThickness="{StaticResource NoBorderThickness}"
                                Padding="{StaticResource PriorityTagPadding}"
                                Margin="{StaticResource PriorityTagMargin}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource SmallCornerRadius}" />
                            </Border.StrokeShape>
                            <Label Text="Medium"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PriorityMediumText}" />
                        </Border>

                        <Border BackgroundColor="{StaticResource PriorityLowBackground}"
                                StrokeThickness="{StaticResource NoBorderThickness}"
                                Padding="{StaticResource PriorityTagPadding}"
                                Margin="{StaticResource PriorityTagMargin}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource SmallCornerRadius}" />
                            </Border.StrokeShape>
                            <Label Text="Low"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PriorityLowText}" />
                        </Border>

                    </FlexLayout>

                    <!-- Inspection List -->
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding TodaysInspections}"
                        Spacing="{StaticResource SpacingLarge}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Inspection">

                                <!--
                                    CardTemplate wraps the card in the shared white-surface Border with
                                    rounded corners and a drop shadow, exactly like the summary cards above.
                                    StatusBadge shows the colour-coded Pending / In Progress / Completed pill.
                                -->
                                <ContentView ControlTemplate="{StaticResource CardTemplate}"
                                             Padding="{StaticResource InspectionCardPadding}">
                                    <ContentView.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnInspectionCardTapped" />
                                    </ContentView.GestureRecognizers>

                                    <Grid ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto,Auto"
                                          RowSpacing="{StaticResource SpacingMedium}">

                                        <!-- Inspection title -->
                                        <Label Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{Binding Title}"
                                               Style="{StaticResource InspectionTitleLabelStyle}"
                                               VerticalOptions="Center" />

                                        <!-- Inspection status — reusable StatusBadge control -->
                                        <controls:StatusBadge 
                                               Grid.Row="0"
                                               Grid.Column="1"
                                               Status="{Binding Status}"
                                               VerticalOptions="Center" />

                                        <!-- Inspection site -->
                                        <Label Grid.Row="1"
                                               Grid.Column="0"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding SiteName, StringFormat='Site: {0}'}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               TextColor="{StaticResource TextSecondary}" />

                                        <!-- Scheduled date and time -->
                                        <Label Grid.Row="2"
                                               Grid.Column="0"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding ScheduledOn, StringFormat='{}{0:dd MMM yyyy, hh:mm tt}'}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               TextColor="{StaticResource TextSecondary}" />

                                    </Grid>

                                </ContentView>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
